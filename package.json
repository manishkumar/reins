{
  "name": "@manishky/reins",
  "version": "0.4.0",
  "description": "Keep control of Claude Code agents you aren't watching. A local-first kit of hooks: hold risky actions for your approval, hard-block forbidden ones, see every agent on one screen, nudge one mid-run, and capture every run to a queryable SQLite file. No daemon, no backend, no account.",
  "keywords": [
    "claude",
    "claude-code",
    "hooks",
    "agent",
    "steering",
    "guardrails",
    "observability",
    "sqlite",
    "local-first"
  ],
  "license": "MIT",
  "author": "Manish Kumar",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manishkumar/reins.git"
  },
  "homepage": "https://github.com/manishkumar/reins#readme",
  "bugs": {
    "url": "https://github.com/manishkumar/reins/issues"
  },
  "bin": {
    "reins": "dist/cli.js"
  },
  "files": [
    "dist",
    "mods/reins-status",
    "!mods/reins-status/hooks/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
